#!/bin/sh
#
# vm-init - build a new VM as a self-contained, mountable sparsebundle
# (.vmsb), and bake a "golden" disk image for it.
#
# The bundle is created wherever you run this from (the current working
# directory), named after the given config file: `vm-init example.vmc`
# from ~/Workspace/VM creates ~/Workspace/VM/example.vmsb - there's no
# other fixed location involved. It's mounted at /Volumes/<basename>
# (e.g. /Volumes/example) only for the duration of this build, then
# detached. bin/vm-start takes a path to the .vmsb file to re-mount it
# and actually run the VM.
#
# "Baking" means: this script boots the freshly-built disk once, with a
# cloud-init seed ISO attached, and lets cloud-init do its one-time
# provisioning (create the user, install packages, configure networking,
# ...) for real, directly onto the disk. Once the guest agent confirms
# it's up, this script shuts it down again and flattens the disk with
# qemu-img so it no longer depends on the base cloud image as a backing
# file. After that, both the base image copy and the cloud-init seed are
# deleted from the bundle - neither is needed again, since every future
# boot (via bin/vm-start) just boots the already-provisioned golden disk
# directly, with no cloud-init involved at all.
#
# See README.md for the full step-by-step description of what this does.

set -eu
LIB_DIR="$(cd "$(dirname "${0}")" && pwd)"
. "${LIB_DIR}/vm-lib"

# Reads a plain variable (e.g. "NAME") that was sourced from the config
# file, and re-exports it namespaced as "VM_NAME". Namespacing avoids
# collisions between short config-file names (NAME, DISK, ...) and the
# rest of this script's own variables, and signals downstream (templates,
# vm-start) that these came from the VM's config. The original short name
# is unset immediately after so it can't be accidentally reused below.
load_vm_variable() {
    _key="${1:-}"
    [ -n "$_key" ] ||
        fail "Environment-variable key was not provided"
    # Fail when the variable is unset or empty.
    [ -n "${!_key:-}" ] ||
        fail "Required environment variable is unset or empty: $_key"
    _target="VM_${_key}"
    export "${_target}=${!_key}"
    printf ' - - Variable: %s=%s\n' "${_target}" "${!_key}"
    unset ${_key}
}

# Like load_vm_variable, but if the config didn't set it (or set it
# empty), uses the given default instead of failing. Used for fields
# that are new (like NETMODE) so existing .vmc files without them keep
# working unchanged, and for fields that only matter in some modes.
load_vm_variable_default() {
    _key="${1:?}"
    _default="${2:?}"
    _val="${!_key:-}"
    [ -n "${_val}" ] || _val="${_default}"
    _target="VM_${_key}"
    export "${_target}=${_val}"
    printf ' - - Variable: %s=%s\n' "${_target}" "${_val}"
    unset ${_key} 2>/dev/null || true
}

# Given a size like "80G" or "512M", print the size in whole gigabytes,
# rounding up. Used to size the sparsebundle relative to the configured
# guest disk size.
size_to_gb() {
    _val="$1"
    _unit="${_val##*[0-9]}"
    _num="${_val%%[!0-9]*}"
    [ -n "$_num" ] ||
        fail "Could not parse a numeric size from: $_val"
    case "$_unit" in
        G|g|'') printf '%d\n' "$_num" ;;
        T|t) printf '%d\n' "$((_num * 1024))" ;;
        M|m) printf '%d\n' "$(((_num + 1023) / 1024))" ;;
        *) fail "Unsupported size unit '${_unit}' in: $_val" ;;
    esac
}

# Verify exactly one argument was provided.
[ "$#" -eq 1 ] ||
    fail "Usage: ${0} <vm config file>"

# Verify the config file
CONFIG_FILE="${1}"
# Verify it exists.
[ -e "${CONFIG_FILE}" ] ||
    fail "File does not exist: ${CONFIG_FILE}"
# Verify it is a regular file.
[ -f "${CONFIG_FILE}" ] ||
    fail "Not a regular file: ${CONFIG_FILE}"
# Verify it is readable.
[ -r "${CONFIG_FILE}" ] ||
    fail "File is not readable: ${CONFIG_FILE}"
printf ' - Using config file: %s\n' "${CONFIG_FILE}"

# `set -a` exports every variable the config file sets (NAME=, DISK=, ...)
# so they exist in the environment for load_vm_variable to pick up below.
set -a
# shellcheck disable=SC1090
. "${CONFIG_FILE}"
set +a
# Every field in the config file is required unless noted otherwise;
# load_vm_variable fails fast if any is missing, rather than building a
# half-configured VM.
load_vm_variable "NAME"
load_vm_variable "INSTANCE"
load_vm_variable "DOMAIN"
load_vm_variable "CPUS"
load_vm_variable "MEMORY"
load_vm_variable "DISK"
load_vm_variable "MAC"
load_vm_variable "OS"

# NETMODE picks the VM's networking backend - see bin/vm-lib for the
# full rationale. It no longer affects *where* anything lives (that's
# always just wherever you run this from - see BUNDLE_PATH below); it
# only affects the qemu invocation itself, further down.
#   bridged (default, for compatibility with configs from before this
#     field existed) - vmnet-bridged onto a real host interface, needing
#     sudo throughout.
#   user - qemu's own usermode/SLIRP networking, fully unprivileged, no
#     sudo anywhere.
load_vm_variable_default "NETMODE" "bridged"
case "${VM_NETMODE}" in
    bridged|user) ;;
    *) fail "Unsupported NETMODE '${VM_NETMODE}' (expected 'bridged' or 'user')" ;;
esac

# IP/GATEWAY only matter for bridged mode, where the guest gets a static
# address on the real network via netplan. In user mode, qemu's SLIRP
# backend hands out its own address over DHCP, so these fields are
# irrelevant - validation is mode-aware rather than requiring them
# unconditionally.
if [ "${VM_NETMODE}" = "bridged" ] ; then
    load_vm_variable "IP"
    load_vm_variable "GATEWAY"
else
    if [ -n "${IP:-}" ] || [ -n "${GATEWAY:-}" ] ; then
        warn "IP/GATEWAY are ignored in NETMODE=user (SLIRP assigns its own address over DHCP)"
    fi
    unset IP GATEWAY 2>/dev/null || true
fi

# Resolve the cloud-init templates relative to this script's own location
# (not the caller's cwd). The templates are part of this repo, not part
# of any individual VM, so they should always come from wherever this
# script itself lives.
SCRIPT_DIR="$(cd "$(dirname "${0}")/.." && pwd)"
REPO_TEMPLATES_DIR="${SCRIPT_DIR}/templates"
[ -d "${REPO_TEMPLATES_DIR}" ] ||
    fail "Templates directory not found: ${REPO_TEMPLATES_DIR}"

# The bundle is created wherever you run this from, named after the
# config file (not the config's own NAME= field, which is a separate,
# guest-internal identity - see templates/meta-data/user-data). A
# "some/path/example.vmc" argument still just produces "example.vmsb" in
# the current directory - only the basename is used, and only the
# trailing .vmc is stripped (a config file named without that extension
# works fine too, it just keeps whatever name it already had).
BUNDLE_BASENAME="$(basename "${CONFIG_FILE}")"
BUNDLE_BASENAME="${BUNDLE_BASENAME%.vmc}"
BUNDLE_PATH="$(pwd)/${BUNDLE_BASENAME}.vmsb"
printf ' - Bundle will be created at(%s)\n' "${BUNDLE_PATH}"

# Fail rather than silently reuse or overwrite an existing VM of the same
# name - both the bundle file and the mount point are checked, since
# either one existing means a naming collision that needs the operator's
# attention (e.g. a leftover mount from a crashed run, or simply already
# having a VM by this name here).
[ -e "${BUNDLE_PATH}" ] &&
    fail "Existing Virtual Machine bundle at '${BUNDLE_PATH}'"
VM_DIR="/Volumes/${BUNDLE_BASENAME}"
[ -e "${VM_DIR}" ] &&
    fail "Mount point already in use: '${VM_DIR}'"
# Host-side runtime state used during the bake boot below (sockets,
# pidfile, log) - inside the mounted volume itself (see bin/vm-lib's
# resolve_vm), so bin/vm-start and the vm-<verb> control scripts find it
# the same way later, with no separate location to keep track of.
RUN_DIR="${VM_DIR}/.run"
PID_FILE="${RUN_DIR}/pid"
QMP_SOCKET="${RUN_DIR}/qmp.sock"
QGA_SOCKET="${RUN_DIR}/qemu-ga.sock"
SERIAL_SOCKET="${RUN_DIR}/serial.sock"
SERIAL_LOG="${RUN_DIR}/serial.log"

# Shared, unprivileged download cache for base OS images (see bin/vm-lib)
# - reused across every VM built on this OS release regardless of
# NETMODE or where each one's .vmsb ends up, so re-running vm-init
# doesn't re-download the same image every time. Each VM bundle still
# gets its own copy (below), so the bundle itself stays fully
# self-contained and portable.
mkdir -p "${IMAGE_CACHE_DIR}"
printf ' - - Image cache folder(%s)\n' "${IMAGE_CACHE_DIR}"
printf '\n\n\n'

# ------------------------------------------------------------------ BUNDLE
# Size the bundle to the guest disk size plus a fixed overhead for
# everything else that lives alongside it on the volume (base image,
# firmware, bios, cidata.iso) - plus enough headroom that the flatten
# step below can briefly hold the pre-flatten overlay, the base image,
# and the new flattened copy all at once. Sparsebundles are sparse on
# disk, so this is only a nominal ceiling, not space actually consumed up
# front.
BUNDLE_GB="$(size_to_gb "${VM_DISK}")"
BUNDLE_OVERHEAD_GB=15
BUNDLE_SIZE="$((BUNDLE_GB + BUNDLE_OVERHEAD_GB))g"
printf ' - Creating sparsebundle(%s) size(%s)\n' "${BUNDLE_PATH}" "${BUNDLE_SIZE}"
# APFS: modern, sparse-file-friendly, handles the large qcow2/base-image
# files well. -volname controls the label shown when mounted, which is
# also what determines the /Volumes/<name> mount point below - note this
# is BUNDLE_BASENAME (the file's own name), not VM_NAME (the config's
# NAME= field, which only affects the guest's own hostname/FQDN).
# hdiutil unconditionally appends its own ".sparsebundle" suffix to
# whatever path you give it that doesn't already end in exactly that
# (observed: asking for "example.vmsb" actually produces
# "example.vmsb.sparsebundle") - there's no flag to suppress this, so
# create it, then rename the result to the exact .vmsb path we actually
# want. A sparsebundle is just a package directory; renaming it doesn't
# affect its validity as a disk image at all.
hdiutil create -type SPARSEBUNDLE -fs APFS -volname "${BUNDLE_BASENAME}" \
  -size "${BUNDLE_SIZE}" "${BUNDLE_PATH}"
mv "${BUNDLE_PATH}.sparsebundle" "${BUNDLE_PATH}"

printf ' - Attaching bundle at(%s)\n' "${VM_DIR}"
hdiutil attach "${BUNDLE_PATH}" -mountpoint "${VM_DIR}"

# From here on, a failure or interruption needs to clean up more than
# just the mount: if the bake boot below is running, its qemu process
# needs to be stopped first (killing it via sudo, since it runs as root)
# so the volume isn't detached out from under a still-running qemu. On
# success, the script reaches its natural end without detaching manually
# - this trap handles that too, uniformly.
BAKE_PID=""
KEEPALIVE_PID=""
cleanup() {
    _rc=$?
    trap - EXIT INT TERM
    [ -z "${KEEPALIVE_PID}" ] || kill "${KEEPALIVE_PID}" 2>/dev/null || true
    if [ -n "${BAKE_PID}" ] && ps -p "${BAKE_PID}" >/dev/null 2>&1 ; then
        warn "Stopping bake-boot qemu process(pid ${BAKE_PID})"
        run_as "$(pid_owner "${BAKE_PID}")" kill "${BAKE_PID}" 2>/dev/null || true
        wait_for_pid_exit "${BAKE_PID}" 30 || true
    fi
    hdiutil detach "${VM_DIR}" >/dev/null 2>&1 || true
    exit "${_rc}"
}
trap cleanup EXIT INT TERM

# Keep a copy of the config inside the bundle - vm-start reads this
# (as "config") to know how to launch the VM, so the bundle stays
# self-describing without needing the original .vmc file around.
cp -v "${CONFIG_FILE}" "${VM_DIR}/config"
printf '\n\n\n'

# ------------------------------------------------------------------ BASE IMAGE
IMAGE_DOMAIN="cloud-images.ubuntu.com"
IMAGE_URL="https://${IMAGE_DOMAIN}/releases/${VM_OS}/release/"
IMAGE_SOURCE="ubuntu-${VM_OS}-server-cloudimg-arm64.img"

# Download into the shared cache (not the bundle) first, so building
# several VMs on the same OS release only pays the download cost once.
CACHED_IMAGE_FILE="${IMAGE_CACHE_DIR}/ubuntu-${VM_OS}.img"
printf ' - Base Image(%s) Refresh\n' "${CACHED_IMAGE_FILE}"
if [ ! -f "${CACHED_IMAGE_FILE}" ] ; then
curl --fail --location --output "${CACHED_IMAGE_FILE}" --progress-bar \
  "${IMAGE_URL}/${IMAGE_SOURCE}"
fi
# Verify the download against Ubuntu's published checksums before trusting
# it as a VM's disk backing file - a corrupted or tampered image would
# otherwise fail silently or much later, deep inside the guest.
IMAGE_CSUM="SHA256SUMS"
IMAGE_SHA256SUM="${IMAGE_CACHE_DIR}/${IMAGE_CSUM}"
curl --fail --location --output "${IMAGE_SHA256SUM}" --progress-bar \
  "${IMAGE_URL}/${IMAGE_CSUM}"
EXPECTED="$(awk -v src="${IMAGE_SOURCE}" '$2 == "*" src || $2 == src {print $1}' "${IMAGE_SHA256SUM}")"
ACTUAL="$(
  shasum -a 256 ${CACHED_IMAGE_FILE} |
  awk '{print $1}'
)"
printf ' - - Checksum Actual:   %s\n' "${ACTUAL}"
printf ' - - Checksum Expected: %s\n' "${EXPECTED}"
[ -n "${EXPECTED}" ] ||
    fail "Could not find an expected checksum for ${IMAGE_SOURCE} in ${IMAGE_SHA256SUM}"
[ "${EXPECTED}" = "${ACTUAL}" ] ||
    fail "Checksum mismatch for ${CACHED_IMAGE_FILE}: expected ${EXPECTED}, got ${ACTUAL}"
printf ' - - Checksum VERIFIED\n'
# Read-only: this cached copy is shared across VMs, so nothing should be
# able to mutate it out from under another VM's build.
chmod 0444 "${CACHED_IMAGE_FILE}"

# Copy the verified image into the bundle itself. This is what makes the
# bundle fully self-contained: the qcow2 disk created below is backed by
# this in-bundle copy (not the shared cache), so the whole VM - including
# its backing image - travels together if the bundle is moved elsewhere.
IMAGES_DIR="${VM_DIR}/images"
mkdir -p "${IMAGES_DIR}"
IMAGE_FILE="${IMAGES_DIR}/ubuntu-${VM_OS}.img"
printf ' - Copying base image into bundle(%s)\n' "${IMAGE_FILE}"
cp -v "${CACHED_IMAGE_FILE}" "${IMAGE_FILE}"
chmod 0444 "${IMAGE_FILE}"
printf '\n\n\n'

# --------------------------------------------------------------------- STORAGE
# The guest's actual disk is a qcow2 copy-on-write overlay on top of the
# base image copy above, not a full copy of it - this keeps the VM's own
# writes small and fast to create. -b/-F point qemu-img at the backing
# file and its format; resize then grows the overlay to the configured
# DISK size (the guest filesystem itself grows into this via cloud-init's
# growpart/resize_rootfs on first boot - see templates/user-data).
VHD_FILE="${VM_DIR}/virtual-hard-disk"
printf ' - Initialize VHD(%s)' "${VHD_FILE}"
if [ ! -f "${VHD_FILE}" ] ; then
  qemu-img create -f qcow2 -F qcow2 -b "${IMAGE_FILE}" "${VHD_FILE}"
  qemu-img resize "${VHD_FILE}" "${VM_DISK}"
fi
printf '\n\n\n'


# -------------------------------------------------------------------- FIRMWARE
# UEFI firmware/vars shipped by Homebrew's qemu package, needed to boot an
# aarch64 guest (there's no legacy BIOS boot path on arm64).
FIRMWARE_DIR="$(brew --prefix qemu)/share/qemu"
printf ' - Firware directory(%s)\n' "${FIRMWARE_DIR}"
FIRMWARE_SOURCE="edk2-aarch64-code.fd"
printf ' - Initialize Firmware(%s)' "${FIRMWARE_SOURCE}"
FIRMWARE_TEMPLATE="${FIRMWARE_DIR}/${FIRMWARE_SOURCE}"
# Firmware code itself is identical for every VM and never written to at
# runtime (see vm-start's -drive ...,readonly=on), so it's just copied in.
FIRMWARE_FILE="${VM_DIR}/firmware"
if [[ ! -f "${FIRMWARE_FILE}" ]] ; then
  cp -v "${FIRMWARE_TEMPLATE}" "${FIRMWARE_FILE}"
fi
printf '\n\n\n'

# ------------------------------------------------------------------------ BIOS
BIOS_SOURCE="edk2-arm-vars.fd"
printf ' - Initialize BIOS(%s)' "${BIOS_SOURCE}"
BIOS_TEMPLATE="${FIRMWARE_DIR}/${BIOS_SOURCE}"
# Unlike firmware, the vars file must be a per-VM writable copy: UEFI
# stores boot-variable state (boot order, etc.) into it at runtime, so
# sharing one file across VMs would let them clobber each other's state.
BIOS_FILE="${VM_DIR}/bios"
if [[ ! -f "${BIOS_FILE}" ]] ; then
  cp -v "${BIOS_TEMPLATE}" "${BIOS_FILE}"
fi
printf '\n\n\n'

# ------------------------------------------------------------------- TEMPLATES
# Build the cloud-init "NoCloud" seed: meta-data, network-config, and
# user-data, rendered from templates/ with this VM's settings, then
# packaged into an ISO the guest reads on first (and every) boot.
#
# network-config and user-data both come in two variants, picked by
# NETMODE (envsubst has no conditionals, so this can't be one template):
#   bridged - templates/network-config (static IP/GATEWAY via netplan)
#             + templates/user-data (full package list, updates/upgrades)
#   user    - templates/network-config-dhcp (SLIRP hands out an address)
#             + templates/user-data-fast (trimmed packages, no
#             package_update/package_upgrade - this project's owner
#             explicitly asked for a fast profile in user mode, since
#             it's meant for quick, repeated debug-loop rebuilds, not
#             production fidelity)
case "${VM_NETMODE}" in
    bridged)
        NETWORK_CONFIG_TEMPLATE="network-config"
        USER_DATA_TEMPLATE="user-data"
        ;;
    user)
        NETWORK_CONFIG_TEMPLATE="network-config-dhcp"
        USER_DATA_TEMPLATE="user-data-fast"
        ;;
esac
TEMP_DIR="$(mktemp -d)"
# VM_BUILD is a unique-per-build instance id. cloud-init only re-runs its
# setup for an instance-id it hasn't seen before, so this forces a fresh
# cloud-init run if a VM with this name is ever rebuilt, instead of the
# guest thinking it's booting the same instance again.
VM_BUILD="$(printf '%x\n' "$(date +%s)")"
export VM_BUILD
envsubst < "${REPO_TEMPLATES_DIR}/meta-data" > "${TEMP_DIR}/meta-data"
envsubst < "${REPO_TEMPLATES_DIR}/${NETWORK_CONFIG_TEMPLATE}" > "${TEMP_DIR}/network-config"
# Bake in the operator's own SSH public key so the guest is reachable
# immediately after boot without any manual console access. NOTE: this
# must be named to match templates/user-data*'s own placeholder
# (${VM_SSH_PUBLIC_KEY}) exactly - envsubst silently substitutes an unset
# variable with an empty string rather than failing, so a name mismatch
# here previously produced a guest with no authorized key and no way to
# log in at all, without any error anywhere.
VM_SSH_PUBLIC_KEY="$(cat "$HOME/.config/ssh/id_ed25519.pub")"
export VM_SSH_PUBLIC_KEY
envsubst < "${REPO_TEMPLATES_DIR}/${USER_DATA_TEMPLATE}" > "${TEMP_DIR}/user-data"
unset VM_BUILD
unset VM_SSH_PUBLIC_KEY
CIDATA_FILE="${VM_DIR}/cidata"
# hdiutil makehybrid -iso appends .iso automatically, producing
# cidata.iso - only needed for the bake boot below, not by bin/vm-start.
hdiutil makehybrid -o "${CIDATA_FILE}" "${TEMP_DIR}" -iso \
  -joliet -default-volume-name cidata
rm -rf "${TEMP_DIR}"
printf '\n\n\n'

# --------------------------------------------------------------- BAKE BOOT
# Boot the disk once with the cloud-init seed attached, so cloud-init's
# one-time provisioning actually runs and writes its results (user
# account, SSH key, packages, network config) directly onto
# virtual-hard-disk. Every future boot (bin/vm-start) skips all of this -
# it just boots the already-provisioned disk with no seed attached.
mkdir -p "${RUN_DIR}"
rm -f "${SERIAL_SOCKET}" "${QGA_SOCKET}" "${QMP_SOCKET}" "${PID_FILE}" "${RUN_DIR}/qemu.log" "${SERIAL_LOG}"
# Pre-create the serial log as the plain user, and before qemu (running
# as root via sudo) ever opens it - writing to an already-existing file
# doesn't change its permissions, so this keeps it readable without sudo
# for debugging, unlike files qemu creates itself from scratch.
: > "${SERIAL_LOG}"
chmod 644 "${SERIAL_LOG}"

QEMU="/opt/homebrew/bin/qemu-system-aarch64"

# Needed for both the qemu launch and the guest-agent polling below; kept
# refreshed in the background since this boot (cloud-init installing and
# upgrading packages) can take several minutes. Only bridged mode's qemu
# runs under sudo at all - user mode needs (and uses) no sudo anywhere.
if [ "${VM_NETMODE}" = "bridged" ] ; then
    sudo -v
    ( while true ; do sudo -n -v 2>/dev/null ; sleep 60 ; done ) &
    KEEPALIVE_PID=$!
fi

printf ' - Booting to let cloud-init provision the disk (this can take a while)...\n'
# Build the full qemu argv as positional params ($@) instead of
# duplicating the whole invocation once per NETMODE/sudo branch - each
# branch below just appends its own bit with `set -- "$@" ...` so the
# sudo/no-sudo launch choice only has to be made once, at the very end.
set -- \
  -name "${VM_NAME}" \
  -machine virt,accel=hvf,highmem=on \
  -cpu host \
  -smp "${VM_CPUS}" \
  -m "${VM_MEMORY}" \
  \
  -drive if=pflash,format=raw,readonly=on,file="${FIRMWARE_FILE}" \
  -drive if=pflash,format=raw,file="${BIOS_FILE}" \
  -drive if=none,id=osdisk,format=qcow2,file="${VHD_FILE}" \
  -device virtio-blk-pci,drive=osdisk \
  \
  -drive if=none,id=seed,format=raw,readonly=on,file="${CIDATA_FILE}.iso" \
  -device virtio-blk-pci,drive=seed

# Networking backend, chosen by NETMODE:
#   bridged - vmnet-bridged onto a real host interface, needing sudo.
#   user    - qemu's own usermode/SLIRP networking, fully unprivileged.
#             hostfwd exposes the guest's sshd on a host port derived
#             from INSTANCE, since SLIRP gives the guest an address
#             that's only reachable from qemu itself, not the host -
#             without this there'd be no way to reach the guest at all
#             (handy for this project's owner debugging a hung boot: it
#             means SSH is actually usable even in user mode).
if [ "${VM_NETMODE}" = "bridged" ] ; then
    set -- "$@" \
      -netdev vmnet-bridged,id=net0,ifname=en1 \
      -device virtio-net-pci,netdev=net0,mac="${VM_MAC}"
else
    SSH_HOST_PORT=$((20000 + 10#${VM_INSTANCE}))
    printf ' - - NETMODE=user: guest sshd will be reachable at localhost:%s\n' "${SSH_HOST_PORT}"
    set -- "$@" \
      -netdev user,id=net0,hostfwd=tcp::"${SSH_HOST_PORT}"-:22 \
      -device virtio-net-pci,netdev=net0,mac="${VM_MAC}"
fi

set -- "$@" \
  -chardev socket,id=qga0,path="${QGA_SOCKET}",server=on,wait=off \
  -device virtio-serial-pci \
  -device virtserialport,chardev=qga0,name=org.qemu.guest_agent.0 \
  \
  -qmp unix:"${QMP_SOCKET}",server=on,wait=off \
  \
  -chardev socket,id=serial0,path="${SERIAL_SOCKET}",server=on,wait=off,logfile="${SERIAL_LOG}",logappend=on \
  -serial chardev:serial0 \
  -monitor none \
  -display none \
  \
  -device virtio-rng-pci

if [ "${VM_NETMODE}" = "bridged" ] ; then
    nohup sudo "$QEMU" "$@" </dev/null >>"${RUN_DIR}/qemu.log" 2>&1 &
else
    nohup "$QEMU" "$@" </dev/null >>"${RUN_DIR}/qemu.log" 2>&1 &
fi
BAKE_PID=$!
disown 2>/dev/null || true
printf '%s\n' "${BAKE_PID}" > "${PID_FILE}"

sleep 2
ps -p "${BAKE_PID}" >/dev/null 2>&1 ||
    fail "qemu exited immediately during bake boot - see ${RUN_DIR}/qemu.log and ${SERIAL_LOG}"

BAKE_TIMEOUT="${VM_BAKE_TIMEOUT:-900}"
printf ' - Waiting for guest agent to respond (up to %ss)\n' "${BAKE_TIMEOUT}"
wait_for_qga_ready "${BAKE_TIMEOUT}" 5 ||
    fail "Guest agent didn't respond within ${BAKE_TIMEOUT}s during bake boot - see ${RUN_DIR}/qemu.log and ${SERIAL_LOG}"
printf ' - Guest is up and cloud-init has provisioned the disk.\n'

printf ' - Requesting shutdown so the disk can be finalized...\n'
qmp_send '{"execute":"system_powerdown"}' >/dev/null
BAKE_SHUTDOWN_TIMEOUT="${VM_BAKE_SHUTDOWN_TIMEOUT:-120}"
wait_for_pid_exit "${BAKE_PID}" "${BAKE_SHUTDOWN_TIMEOUT}" ||
    fail "Guest didn't power off within ${BAKE_SHUTDOWN_TIMEOUT}s during bake boot"
BAKE_PID=""
rm -f "${PID_FILE}"

kill "${KEEPALIVE_PID}" 2>/dev/null || true
KEEPALIVE_PID=""
printf '\n\n\n'

# ------------------------------------------------------------------ FLATTEN
# virtual-hard-disk is still a thin qcow2 overlay backed by the base
# image copy - it only has the blocks cloud-init's provisioning actually
# changed. Flatten it into a fully standalone image (no backing file), so
# the base image and cloud-init seed are no longer needed by anything.
printf ' - Finalizing golden disk image(%s)\n' "${VHD_FILE}"
qemu-img convert -p -f qcow2 -O qcow2 "${VHD_FILE}" "${VHD_FILE}.flattened"
mv "${VHD_FILE}.flattened" "${VHD_FILE}"

printf ' - Removing base image and cloud-init seed (no longer needed after baking)\n'
rm -rf "${IMAGES_DIR}"
rm -f "${CIDATA_FILE}.iso"
printf '\n\n\n'

# --------------------------------------------------------------------- DETACH
# The build is done - detach so the bundle goes back to being an inert
# file on disk. It stays that way until vm-start mounts it again to run
# the VM. Reaching the end of the script normally triggers the cleanup
# trap above, which detaches it - no separate detach needed here.

printf '\n'
printf 'VM built at: %s\n' "${BUNDLE_PATH}"
printf 'Run "bin/vm-start %s" to mount and start it - it will be reachable\n' "${BUNDLE_PATH}"
printf 'as "%s" (e.g. "bin/vm-status %s") once running.\n' "${BUNDLE_BASENAME}" "${BUNDLE_BASENAME}"
