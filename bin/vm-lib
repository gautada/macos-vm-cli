#!/bin/sh
#
# vm-lib - shared helpers for vm-init, vm-start, vm-fulltest, and the
# vm-<verb> control scripts (vm-status, vm-halt, vm-stop, vm-restart,
# vm-pause, vm-resume). Meant to be sourced, not executed directly.
#
# Every VM runs in one of two network modes, chosen per-VM by the
# NETMODE field in its .vmc config file (see bin/vm-init):
#
#   bridged (default) - -netdev vmnet-bridged, needing raw host network
#     access, so qemu itself runs under `sudo`, and everything it creates
#     (sockets, etc.) ends up root-owned.
#   user - qemu's own usermode/SLIRP networking (-netdev user), which
#     needs no special privilege at all - qemu runs as the plain invoking
#     user, so nothing it creates needs sudo to read or control either.
#
# A VM is just a .vmsb sparsebundle file, addressed by path - bin/vm-init
# creates one wherever you run it from (named after the config file you
# gave it), and bin/vm-start takes a path to one directly. There's no
# fixed, well-known location a VM "lives" in on disk. Once it's running,
# though, it's mounted at a predictable place - /Volumes/<name>, where
# <name> is the .vmsb's own basename - and everything the vm-<verb>
# control scripts need (pidfile, QMP/guest-agent/serial sockets, logs)
# lives *inside* that mount, under a hidden .run/ subdirectory. That's
# what lets those scripts, which only ever take a bare VM name rather
# than a path, find everything with no search or lookup at all:
# resolve_vm() below just computes /Volumes/<name>/.run/... directly.
#
# Socket/process ownership is used to decide, automatically and per-call,
# whether a given command needs `sudo` - see path_owner(), pid_owner()
# and run_as() below. This keeps "try without sudo, only escalate if the
# thing you're touching is actually root-owned" in one place, rather than
# needing every caller to know and pass the mode through explicitly.

warn() {
    printf 'WARN: %s\n' "$*" >&2
}

fail() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

command -v jq >/dev/null 2>&1 ||
    fail "This script requires 'jq' (brew install jq)"
command -v nc >/dev/null 2>&1 ||
    fail "This script requires 'nc'"

# Shared, unprivileged download cache for base OS images - keyed only by
# OS release, so building many VMs never re-downloads the same image
# twice no matter where each one's .vmsb ends up. An ordinary per-user
# cache directory; no sudo is ever involved in creating or using it, in
# either NETMODE (only the qemu process itself, and its sockets, care
# about NETMODE).
IMAGE_CACHE_DIR="${HOME}/.cache/vm-cli/images"

# Prints the username that owns the given path (file or directory), or
# nothing if it doesn't exist / can't be stat'd.
path_owner() {
    stat -f '%Su' "$1" 2>/dev/null
}

# Prints the username that owns the given running pid, or nothing if
# it's not currently running.
pid_owner() {
    ps -o user= -p "$1" 2>/dev/null | tr -d '[:space:]'
}

# Runs "$@", prefixed with sudo only if the given owner is "root" and we
# aren't already root ourselves. This is the single place that decides
# "does touching this thing need sudo" - every socket/process
# interaction in this library goes through it instead of hardcoding
# sudo, so a user-mode VM (everything plain-user-owned, since qemu itself
# runs unprivileged) never invokes sudo at all, while a bridged-mode VM
# (qemu running as root) keeps working exactly as before.
run_as() {
    _owner="$1"; shift
    if [ "${_owner}" = "root" ] && [ "$(id -u)" -ne 0 ] ; then
        sudo "$@"
    else
        "$@"
    fi
}

# Resolves a VM name into its paths. A VM's mount point is always
# predictable from its name alone (/Volumes/<name>), so this never needs
# to search anywhere or know where its .vmsb file lives on disk - it
# doesn't even check that the mount actually exists. Existence/liveness
# is checked separately, by vm_is_running() below: a VM that isn't
# currently mounted here is simply "not running" as far as these scripts
# are concerned, whether it's never been started or its .vmsb lives
# somewhere else entirely.
#
# Sets: VM_NAME, VM_DIR, RUN_DIR, PID_FILE, QMP_SOCKET, QGA_SOCKET,
# SERIAL_SOCKET, SERIAL_LOG.
resolve_vm() {
    VM_NAME="${1:-}"
    [ -n "${VM_NAME}" ] ||
        fail "Usage: ${0} <vm name>"

    VM_DIR="/Volumes/${VM_NAME}"
    # Hidden, inside the mounted volume itself - host-side runtime state
    # (sockets, pidfile, logs) travels with the VM for as long as it's
    # running, with no separate location to keep track of.
    RUN_DIR="${VM_DIR}/.run"
    PID_FILE="${RUN_DIR}/pid"
    QMP_SOCKET="${RUN_DIR}/qmp.sock"
    QGA_SOCKET="${RUN_DIR}/qemu-ga.sock"
    SERIAL_SOCKET="${RUN_DIR}/serial.sock"
    SERIAL_LOG="${RUN_DIR}/serial.log"
}

# Sets VM_PID and returns success if the VM's pidfile names a live
# process, failure otherwise. Does not fail the script - callers decide
# whether "not running" is an error.
vm_is_running() {
    [ -f "${PID_FILE}" ] || return 1
    VM_PID="$(command cat "${PID_FILE}")"
    [ -n "${VM_PID}" ] || return 1
    ps -p "${VM_PID}" >/dev/null 2>&1
}

# Like resolve_vm, but fails with a clear message unless the VM is
# actually running with a live QMP socket. Use this in every control
# script that needs to actually talk to a running VM.
require_running_vm() {
    resolve_vm "${1:-}"
    vm_is_running ||
        fail "VM \"${VM_NAME}\" is not running"
    [ -S "${QMP_SOCKET}" ] ||
        fail "QMP socket not found(${QMP_SOCKET}); can't control this VM"
}

# Sends the QMP capabilities handshake followed by each given single-line
# JSON command over the VM's QMP socket (QMP_SOCKET must already be set,
# e.g. by require_running_vm), and prints the raw newline-delimited JSON
# responses. The trailing sleep gives qemu a moment to reply before nc's
# own idle timeout closes the connection.
#
# Whether this needs sudo is decided fresh on every call by checking who
# actually owns the socket (see run_as) - a bridged VM's root-owned
# socket needs it, a user-mode VM's plain-user-owned socket doesn't.
qmp_send() {
    {
        printf '%s\n' '{"execute":"qmp_capabilities"}'
        for _cmd in "$@" ; do
            printf '%s\n' "${_cmd}"
        done
        sleep 1
    } | run_as "$(path_owner "${QMP_SOCKET}")" nc -U -w 3 "${QMP_SOCKET}"
}

# Sends a single QMP command and fails with qemu's own error message if
# it returns one.
qmp_run() {
    _reply="$(qmp_send "$1")"
    _error="$(printf '%s\n' "${_reply}" | jq -r 'select(.error != null) | .error.desc' 2>/dev/null | tail -n1)"
    [ -z "${_error}" ] ||
        fail "qemu: ${_error}"
    printf '%s\n' "${_reply}"
}

# Sends a single command to the guest agent (QGA_SOCKET must already be
# set) and prints its raw reply. Unlike QMP, the guest agent protocol
# needs no capabilities handshake - commands can be sent as soon as it's
# connected to. Sudo is decided the same way as qmp_send, above.
#
# NOTE: prefer wait_for_qga_ready (below) over calling this in a polling
# loop - see the comment on that function for why.
qga_send() {
    printf '%s\n' "$1" | run_as "$(path_owner "${QGA_SOCKET}")" nc -U -w "${2:-3}" "${QGA_SOCKET}"
}

# Returns success if the guest agent answers a ping within the given
# per-attempt timeout in seconds (default 3). A single one-shot check;
# see wait_for_qga_ready for polling.
qga_ping() {
    _reply="$(qga_send '{"execute":"guest-ping"}' "${1:-3}" 2>/dev/null)"
    printf '%s\n' "${_reply}" | jq -e 'select(.return != null)' >/dev/null 2>&1
}

# Prints a clear "starting to wait" line: what we're waiting for, the
# wall-clock time right now, and the configured timeout - so there's
# never any ambiguity about how much real time is allowed, independent of
# whatever progress indicator the wait loop itself prints.
_wait_announce_start() {
    printf ' - %s (up to %ss, started %s)\n' "$1" "$2" "$(date '+%H:%M:%S')" >&2
}

# Prints a periodic progress line showing REAL elapsed wall-clock seconds
# (computed from a start epoch, not counted in fixed per-iteration
# increments - a loop that occasionally takes an extra beat, e.g. to
# reconnect, would otherwise silently under-count how much time has
# actually passed) against the timeout, plus the current wall-clock time.
# This replaces plain dot-per-poll counters, which are easy to misread -
# e.g. mistaking 60 dots from a 2-second-per-iteration loop for 60
# elapsed seconds, when it's actually 120.
_wait_progress_note() {
    printf '   ...%ss / %ss elapsed (%s)\n' "$1" "$2" "$(date '+%H:%M:%S')" >&2
}

# Waits up to $1 seconds (polling every $2, default 3s) for the guest
# agent to answer a guest-ping. Returns success (0) if it answered in
# time, failure (1) on timeout.
#
# This intentionally holds ONE long-lived connection to QGA_SOCKET open
# for the whole wait, instead of reconnecting fresh for every attempt
# (which is what a naive `while ! qga_ping; do sleep; done` loop does).
# That distinction is the actual fix for this project's mystery
# guest-agent hang: qemu's virtio-serial port only has one "host peer"
# slot, and disconnecting/reconnecting it - especially before the guest
# has even booted far enough for qemu-ga to open its end - was observed
# (via templates/*, serial.log evidence) to occasionally leave the port
# wedged for the rest of that boot, with qemu-guest-agent's systemd unit
# reporting "started" but never actually answering anything again, no
# matter how long you keep polling or how many times you reconnect.
# Holding a single connection open for the entire wait means the guest
# never sees more than one connect event, so it can't get desynced by
# reconnect churn. Any bytes written before qemu-ga is actually listening
# just sit buffered in the virtio queue until it opens the port.
wait_for_qga_ready() {
    _timeout="$1"
    _interval="${2:-3}"
    _owner="$(path_owner "${QGA_SOCKET}")"
    _start_epoch="$(date +%s)"
    _wait_announce_start "Waiting for guest agent to respond" "${_timeout}"

    _fifo="$(mktemp -u "${TMPDIR:-/tmp}/vm-qga.XXXXXX")"
    mkfifo "${_fifo}" || fail "Could not create fifo(${_fifo})"
    _out="$(mktemp "${TMPDIR:-/tmp}/vm-qga-out.XXXXXX")"

    _nc_pid=""
    _start_nc() {
        # Keep the fifo open for writing on our own end (fd 9) too, so
        # nc's read side never sees EOF just because we're between
        # writes - only wait_for_qga_ready's own cleanup closes it.
        run_as "${_owner}" nc -U "${QGA_SOCKET}" <"${_fifo}" >>"${_out}" 2>/dev/null &
        _nc_pid=$!
    }
    _start_nc
    # NOTE: this whole function runs under the caller's `set -eu` (it's
    # sourced into their shell, not a subprocess) - a bare failing
    # statement here (not an if/while condition) would abort the entire
    # calling script, not just this wait. The exec/printf calls below are
    # therefore explicitly guarded with `|| true` even though failure is
    # expected to be rare, so a transient hiccup degrades to "this
    # attempt didn't get through" rather than crashing vm-init/vm-start
    # outright.
    exec 9>"${_fifo}" || true

    _elapsed=0
    _last_note=0
    _ready=1
    while [ "${_elapsed}" -lt "${_timeout}" ] ; do
        printf '%s\n' '{"execute":"guest-ping"}' >&9 2>/dev/null || true
        sleep "${_interval}"
        _elapsed=$(( $(date +%s) - _start_epoch ))
        if jq -e 'select(.return != null)' <"${_out}" >/dev/null 2>&1 ; then
            _ready=0
            break
        fi
        if [ $((_elapsed - _last_note)) -ge 15 ] ; then
            _wait_progress_note "${_elapsed}" "${_timeout}"
            _last_note="${_elapsed}"
        fi
        # A transient hiccup (e.g. the connection got torn down for some
        # reason outside our control) shouldn't wedge the rest of the
        # wait - reconnect and keep going rather than give up early.
        # NOTE: liveness is checked with `ps -p`, not `kill -0` - in
        # bridged mode nc runs under sudo (root-owned), and `kill -0`
        # from a plain user gets EPERM (not "process is gone") against a
        # root-owned pid, which would misread "alive but not mine to
        # signal" as dead and spawn a duplicate nc every single
        # iteration. `ps -p` just checks the process table, no
        # permission barrier either way - same reasoning as vm_is_running
        # and wait_for_pid_exit elsewhere in this file.
        if ! ps -p "${_nc_pid}" >/dev/null 2>&1 ; then
            exec 9>&- || true
            _start_nc
            exec 9>"${_fifo}" || true
        fi
    done

    exec 9>&- || true
    # Likewise: this may be sudo's monitor pid rather than nc's own (see
    # the module comment at the top of this file), which is root-owned
    # in bridged mode - route through run_as rather than assuming a
    # plain `kill` can signal it.
    run_as "${_owner}" kill "${_nc_pid}" 2>/dev/null || true
    rm -f "${_fifo}" "${_out}"

    _elapsed=$(( $(date +%s) - _start_epoch ))
    if [ "${_ready}" -eq 0 ] ; then
        printf ' - Guest agent responded after %ss\n' "${_elapsed}" >&2
    else
        printf ' - Guest agent did not respond (waited %ss, timeout %ss)\n' "${_elapsed}" "${_timeout}" >&2
    fi
    return "${_ready}"
}

# Confirms cloud-init has *actually finished* - not just that the guest
# agent answered a ping, which only proves qemu-ga itself is up and
# listening. cloud-init could still be doing its own final-stage work
# after that (write_files, final_message, ...), and initiating a
# shutdown while it's still genuinely busy is a real, separate suspect
# for a slow/hung bake shutdown - see README's "Diagnosing a hung boot".
#
# Uses the guest agent's guest-exec to run `cloud-init status --wait`
# inside the guest - a real cloud-init command purpose-built for exactly
# this kind of synchronization, which blocks until every stage is done
# and returns a real exit code (0 = done, 2 = degraded/recoverable
# warnings, anything else = a real error) - then polls guest-exec-status
# for that exit code. Only call this after wait_for_qga_ready has already
# succeeded; guest-exec would just fail to launch otherwise.
#
# Uses one-shot qga_send calls (a fresh connection per request) rather
# than wait_for_qga_ready's persistent-connection trick - that trick
# exists because reconnecting *before* the guest has booted far enough
# to open its end of the port can desync it; by this point the agent is
# already confirmed up and answering, which is a different, and believed
# safe, window. If this wait itself is ever seen to hang the way the
# original guest-ping problem did, that assumption is the first thing to
# revisit.
wait_for_cloud_init_done() {
    _timeout="$1"
    _start_epoch="$(date +%s)"
    _wait_announce_start "Waiting for cloud-init to report done" "${_timeout}"

    _launch="$(qga_send '{"execute":"guest-exec","arguments":{"path":"/usr/bin/cloud-init","arg":["status","--wait"],"capture-output":true}}' 5 2>/dev/null)"
    _pid="$(printf '%s\n' "${_launch}" | jq -r 'select(.return.pid != null) | .return.pid' 2>/dev/null | tail -n1)"
    if [ -z "${_pid}" ] ; then
        warn "Could not launch 'cloud-init status --wait' via guest-exec - skipping this check"
        return 1
    fi

    _last_note=0
    while true ; do
        _elapsed=$(( $(date +%s) - _start_epoch ))
        if [ "${_elapsed}" -ge "${_timeout}" ] ; then
            printf ' - cloud-init still not done (waited %ss, timeout %ss)\n' "${_elapsed}" "${_timeout}" >&2
            return 1
        fi
        _status="$(qga_send "{\"execute\":\"guest-exec-status\",\"arguments\":{\"pid\":${_pid}}}" 5 2>/dev/null)"
        if printf '%s\n' "${_status}" | jq -e 'select(.return.exited == true)' >/dev/null 2>&1 ; then
            _exitcode="$(printf '%s\n' "${_status}" | jq -r '.return.exitcode // empty' 2>/dev/null)"
            _elapsed=$(( $(date +%s) - _start_epoch ))
            case "${_exitcode}" in
                0)
                    printf ' - cloud-init reported done after %ss\n' "${_elapsed}" >&2
                    return 0
                    ;;
                2)
                    warn "cloud-init reported a degraded status (exit 2, recoverable warnings only) after ${_elapsed}s - continuing"
                    return 0
                    ;;
                *)
                    warn "cloud-init status --wait exited ${_exitcode} after ${_elapsed}s - see serial.log"
                    return 1
                    ;;
            esac
        fi
        if [ $((_elapsed - _last_note)) -ge 15 ] ; then
            _wait_progress_note "${_elapsed}" "${_timeout}"
            _last_note="${_elapsed}"
        fi
        sleep 3
    done
}

# Waits (up to $2 seconds) for pid $1 to actually disappear. Returns
# success if it exited in time; returns failure (without erroring the
# script) if the timeout was reached, leaving it to the caller to decide
# what that means.
wait_for_pid_exit() {
    _pid="$1"
    _timeout="$2"
    _start_epoch="$(date +%s)"
    _wait_announce_start "Waiting for pid ${_pid} to exit" "${_timeout}"
    _last_note=0
    while ps -p "${_pid}" >/dev/null 2>&1 ; do
        _elapsed=$(( $(date +%s) - _start_epoch ))
        if [ "${_elapsed}" -ge "${_timeout}" ] ; then
            printf ' - Still running (waited %ss, timeout %ss)\n' "${_elapsed}" "${_timeout}" >&2
            return 1
        fi
        if [ $((_elapsed - _last_note)) -ge 15 ] ; then
            _wait_progress_note "${_elapsed}" "${_timeout}"
            _last_note="${_elapsed}"
        fi
        sleep 2
    done
    _elapsed=$(( $(date +%s) - _start_epoch ))
    printf ' - Exited after %ss\n' "${_elapsed}" >&2
    return 0
}

# Waits (up to $1 seconds) for the VM's pid (VM_PID) to actually
# disappear, then removes its pidfile and detaches the bundle. bin/vm-
# start no longer blocks in the foreground for the life of the VM (it
# returns once the guest is up), so whichever script actually ends the VM
# - bin/vm-halt or bin/vm-stop - is responsible for this instead. Fails
# without detaching if qemu is still running when the timeout is reached,
# since the volume must stay mounted for as long as it's in use.
wait_for_exit_and_detach() {
    wait_for_pid_exit "${VM_PID}" "$1" ||
        fail "VM \"${VM_NAME}\" (pid ${VM_PID}) hasn't exited after $1s. Leaving the volume mounted since qemu is still running."
    rm -f "${PID_FILE}"
    hdiutil detach "${VM_DIR}" >/dev/null 2>&1 ||
        warn "Could not detach ${VM_DIR}; you may need to run: hdiutil detach \"${VM_DIR}\""
}
